# ==============================================================================
# Enterprise Document Intelligence & Agentic RAG Platform - Environment Variables
# ==============================================================================
# Copy this file to .env and configure for your local or production environment.
# Never commit .env containing real credentials to version control.

# Application & Environment
APP_ENV=development
LOG_LEVEL=INFO
DEBUG=false

# Server Settings
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database (PostgreSQL for production, SQLite for local development)
DATABASE_URL=sqlite+aiosqlite:///./enterprise_rag_dev.db
DATABASE_URL_SYNC=sqlite:///./enterprise_rag_dev.db
# Example for PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://rag_user:rag_password@localhost:5432/enterprise_rag
# DATABASE_URL_SYNC=postgresql://rag_user:rag_password@localhost:5432/enterprise_rag

# Redis (Caching, Sliding-Window Rate Limiting, Celery broker)
REDIS_URL=redis://localhost:6379/0

# Qdrant Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Security & Authentication (JWT RBAC)
# IMPORTANT: Generate a secure 32+ character random string for production
JWT_SECRET=change_this_to_a_secure_random_secret_in_production_min_32_chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# LLM Providers (groq | openrouter | ollama)
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# LLM Safety & Guardrails
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=2048
LLM_RATE_LIMIT_PER_MINUTE=10

# Agentic RAG Limits
AGENT_MAX_RETRIEVAL_ATTEMPTS=3
AGENT_MAX_TOOL_CALLS=10

# SSE Streaming Limits
SSE_MAX_CONCURRENT_STREAMS_PER_USER=3
